<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- NFC Permissions -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <!-- Query installed apps to display selection list -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Haptic feedback during NFC scan -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Notification permission for active focus session indicator -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- System overlay permission (for reliable interception on various Android versions) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />

    <application
        android:name=".FreeTagApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_freetag_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_freetag_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.FreeTag">

        <!-- Main Dashboard & Settings Activity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Fallback NFC tag discovered intent filter -->
            <intent-filter>
                <action android:name="android.nfc.action.TAG_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Lock Interception Screen Activity -->
        <activity
            android:name=".ui.LockOverlayActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:noHistory="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.FreeTag.Overlay" />

        <!-- Core App Blocker Accessibility Service -->
        <service
            android:name=".service.AppBlockerService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Quick Settings Tile for one-tap presence activation -->
        <service
            android:name=".service.FocusTileService"
            android:icon="@drawable/ic_freetag_logo"
            android:label="@string/tile_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Home Screen Desktop App Widget -->
        <receiver
            android:name=".receiver.FreeTagWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.freetag.app.UPDATE_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/freetag_widget_info" />
        </receiver>

    </application>

</manifest>
